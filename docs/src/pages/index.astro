---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import RuntimeCards from '../components/RuntimeCards.astro';
import Stats from '../components/Stats.astro';
import CodeComparison from '../components/CodeComparison.astro';
import Features from '../components/Features.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import UseCases from '../components/UseCases.astro';
import { bench, formatOps } from '../data/benchmarks';
---

<BaseLayout
  title="hitlimit - Fastest Rate Limiter for Node.js & Bun | Express, Fastify, Hono, NestJS | express-rate-limit Alternative"
  description={`High-performance rate limiting middleware for Express, Fastify, Hono, NestJS, Bun & Elysia. Over 4x faster than express-rate-limit at scale (${formatOps(bench.node.memory.multi10k.opsPerSec)} vs ${formatOps(bench.competitors.expressRateLimit.memory.multi10k.opsPerSec)} ops/sec). Zero dependencies, tiered limits, Redis/SQLite/Postgres/MongoDB/MySQL stores, zero config. The modern alternative to express-rate-limit, @fastify/rate-limit, hono-rate-limiter, and rate-limiter-flexible.`}
  keywords="rate limit, rate limiter, express-rate-limit alternative, @fastify/rate-limit alternative, hono-rate-limiter alternative, fastify rate limit, fastify rate limiter, fastify plugin, hono rate limit, hono rate limiter, hono middleware, rate-limiter-flexible alternative, nodejs rate limit, bun rate limit, express rate limit, nestjs throttler, elysia rate limit, api rate limiting, ddos protection, brute force protection, postgres rate limit, redis rate limiter, mongodb rate limiter, mysql rate limiter"
>
  <Hero />
  <RuntimeCards />
  <Stats />
  <CodeComparison />
  <Features />
  <ComparisonTable />
  <UseCases />
</BaseLayout>
