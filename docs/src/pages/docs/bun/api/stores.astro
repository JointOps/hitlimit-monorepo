  <h2 id="postgres-store">postgresStore()</h2>

  <p>
    PostgreSQL-backed storage for distributed deployments. Uses named prepared statements
    for query plan caching and atomic upserts for race-condition-free increments.
  </p>

  <h3>Signature</h3>

  <div class="code-block">
    <pre><code><span class="kw">function</span> <span class="fn">postgresStore</span>(options: PostgresStoreOptions): HitLimitStore</code></pre>
  </div>

  <h3>Import</h3>

  <div class="code-block">
    <pre><code><span class="kw">import</span> {"{"} postgresStore {"}"} <span class="kw">from</span> <span class="str">'@joint-ops/hitlimit-bun/stores/postgres'</span></code></pre>
  </div>

  <h3>Options</h3>

  <table>
    <thead>
      <tr>
        <th>Option</th>
        <th>Type</th>
        <th>Default</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>url</code></td>
        <td><code>string</code></td>
        <td>—</td>
        <td>Connection string. Store creates and owns a Bun SQL client. Closed on <code>shutdown()</code>.</td>
      </tr>
      <tr>
        <td><code>client</code></td>
        <td><code>SQL</code></td>
        <td>—</td>
        <td>Caller-owned Bun <code>SQL</code> instance. Store uses it but does not close it.</td>
      </tr>
      <tr>
        <td><code>pool</code></td>
        <td><code>Pool</code></td>
        <td>—</td>
        <td><strong>Deprecated.</strong> Legacy <code>pg.Pool</code>. Caller-owned, store does not close it.</td>
      </tr>
      <tr>
        <td><code>tablePrefix</code></td>
        <td><code>string</code></td>
        <td><code>'hitlimit'</code></td>
        <td>Prefix for rate limit table names.</td>
      </tr>
      <tr>
        <td><code>cleanupInterval</code></td>
        <td><code>number</code></td>
        <td><code>60000</code></td>
        <td>Interval (ms) to clean expired entries.</td>
      </tr>
      <tr>
        <td><code>skipTableCreation</code></td>
        <td><code>boolean</code></td>
        <td><code>false</code></td>
        <td>Skip automatic table creation on startup.</td>
      </tr>
    </tbody>
  </table>

