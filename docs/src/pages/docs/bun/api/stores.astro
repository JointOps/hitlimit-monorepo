<span class="kw">const</span> limiter = <span class="fn">hitlimit</span>({"{"}
  limit: <span class="num">100</span>,
  window: <span class="str">'1m'</span>,
  store: <span class="fn">postgresStore</span>({"{"} url: <span class="str">'postgres://localhost:5432/mydb'</span> {"}"})
{"}"})</code></pre>
  </div>

  <h2 id="custom-stores">Custom Stores</h2>

  <p>
    Implement the <code>HitLimitStore</code> interface to create a custom storage backend.
    At minimum, provide <code>hit()</code> and <code>reset()</code> methods.
  </p>

  <div class="code-block">
    <div class="code-header">
      <div class="code-dots">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
      </div>
      <span class="code-filename">custom-store.ts</span>
    </div>
    <pre><code><span class="kw">import</span> <span class="kw">type</span> {"{"} HitLimitStore, StoreResult {"}"} <span class="kw">from</span> <span class="str">'@joint-ops/hitlimit-types'</span>

<span class="kw">class</span> MyStore <span class="kw">implements</span> HitLimitStore {"{"}
  isSync = <span class="kw">true</span> <span class="kw">as const</span>
  <span class="kw">private</span> data = <span class="kw">new</span> <span class="fn">Map</span>&lt;<span class="kw">string</span>, {"{"} count: <span class="kw">number</span>; resetAt: <span class="kw">number</span> {"}"}&gt;()

  <span class="fn">hit</span>(key: <span class="kw">string</span>, windowMs: <span class="kw">number</span>, _limit: <span class="kw">number</span>): StoreResult {"{"}
    <span class="kw">const</span> now = Date.<span class="fn">now</span>()
    <span class="kw">const</span> entry = <span class="kw">this</span>.data.<span class="fn">get</span>(key)

    <span class="kw">if</span> (entry && now &lt; entry.resetAt) {"{"}
      entry.count++
      <span class="kw">return</span> {"{"} count: entry.count, resetAt: entry.resetAt {"}"}
    {"}"}

    <span class="kw">const</span> resetAt = now + windowMs
    <span class="kw">this</span>.data.<span class="fn">set</span>(key, {"{"} count: <span class="num">1</span>, resetAt {"}"})
    <span class="kw">return</span> {"{"} count: <span class="num">1</span>, resetAt {"}"}
  {"}"}

  <span class="fn">reset</span>(key: <span class="kw">string</span>): <span class="kw">void</span> {"{"}
    <span class="kw">this</span>.data.<span class="fn">delete</span>(key)
  {"}"}

  <span class="fn">shutdown</span>(): <span class="kw">void</span> {"{"}
    <span class="kw">this</span>.data.<span class="fn">clear</span>()
  {"}"}
{"}"}</code></pre>
  </div>

  <p>
    Set <code>isSync = true</code> if your store's <code>hit()</code> method returns
    a <code>StoreResult</code> directly (not a <code>Promise</code>). This lets the
    limiter skip <code>await</code> on the hot path for better performance.
  </p>

