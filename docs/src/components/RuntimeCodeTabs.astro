---
interface Props {
  node: string;
  bun: string;
  nodeFile?: string;
  bunFile?: string;
  id?: string;
}

const { node, bun, nodeFile, bunFile, id = `rtabs-${Math.random().toString(36).slice(2, 8)}` } = Astro.props;
---

<div class="runtime-code-tabs" data-runtime-tabs-id={id}>
  <div class="runtime-tabs-header">
    <div class="runtime-tabs-buttons" role="tablist" aria-label="Select runtime">
      <button class="runtime-tab-btn active" data-runtime-tab="node" type="button" role="tab" aria-selected="true" tabindex="0">
        <svg class="runtime-tab-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M11.998 24c-.321 0-.641-.084-.922-.247l-2.936-1.737c-.438-.245-.224-.332-.08-.383.585-.203.703-.25 1.328-.604.065-.037.151-.023.218.017l2.256 1.339c.082.045.197.045.272 0l8.795-5.076c.082-.047.134-.141.134-.238V6.921c0-.099-.053-.192-.137-.242l-8.791-5.072c-.081-.047-.189-.047-.271 0L3.075 6.68c-.084.049-.137.142-.137.24v10.15c0 .097.054.189.139.235l2.409 1.392c1.307.654 2.108-.116 2.108-.89V7.787c0-.142.114-.253.256-.253h1.115c.139 0 .255.112.255.253v10.021c0 1.745-.95 2.745-2.604 2.745-.508 0-.909 0-2.026-.551L2.28 18.675c-.57-.329-.922-.945-.922-1.604V6.921c0-.659.353-1.275.922-1.603l8.795-5.082c.557-.315 1.296-.315 1.848 0l8.794 5.082c.57.329.924.944.924 1.603v10.15c0 .659-.354 1.273-.924 1.604l-8.794 5.078C12.643 23.916 12.324 24 11.998 24zM19.099 13.993c0-1.9-1.284-2.406-3.987-2.763-2.731-.361-3.009-.548-3.009-1.187 0-.528.235-1.233 2.258-1.233 1.807 0 2.473.389 2.747 1.607.024.115.129.199.247.199h1.141c.071 0 .138-.031.186-.081.048-.054.074-.123.067-.196-.177-2.098-1.571-3.076-4.388-3.076-2.508 0-4.004 1.058-4.004 2.833 0 1.925 1.488 2.457 3.895 2.695 2.88.282 3.103.703 3.103 1.269 0 .983-.789 1.402-2.642 1.402-2.327 0-2.839-.584-3.011-1.742-.02-.124-.126-.215-.253-.215h-1.137c-.141 0-.254.112-.254.253 0 1.482.806 3.248 4.655 3.248 2.855 0 4.453-1.097 4.453-2.98z"/>
        </svg>
        Node.js
      </button>
      <button class="runtime-tab-btn" data-runtime-tab="bun" type="button" role="tab" aria-selected="false" tabindex="-1">
        <svg class="runtime-tab-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 22.596c6.628 0 12-4.338 12-9.688 0-3.318-2.057-6.248-5.219-7.986-1.286-.715-2.297-1.357-3.139-1.89C14.058 2.025 13.08 1.404 12 1.404c-1.097 0-2.334.785-3.966 1.821a49.92 49.92 0 0 1-2.816 1.697C2.057 6.66 0 9.59 0 12.908c0 5.35 5.372 9.687 12 9.687v.001ZM10.599 4.715c.334-.759.503-1.58.498-2.409 0-.145.202-.187.23-.029.658 2.783-.902 4.162-2.057 4.624-.124.048-.199-.121-.103-.209a5.763 5.763 0 0 0 1.432-1.977Zm2.058-.102a5.82 5.82 0 0 0-.782-2.306v-.016c-.069-.123.086-.263.185-.172 1.962 2.111 1.307 4.067.556 5.051-.082.103-.23-.003-.189-.126a5.85 5.85 0 0 0 .23-2.431Zm1.776-.561a5.727 5.727 0 0 0-1.612-1.806v-.014c-.112-.085-.024-.274.114-.218 2.595 1.087 2.774 3.18 2.459 4.407a.116.116 0 0 1-.049.071.11.11 0 0 1-.153-.026.122.122 0 0 1-.022-.083 5.891 5.891 0 0 0-.737-2.331Zm-5.087.561c-.617.546-1.282.76-2.063 1-.117 0-.195-.078-.156-.181 1.752-.909 2.376-1.649 2.999-2.778 0 0 .155-.118.188.085 0 .304-.349 1.329-.968 1.874Zm4.945 11.237a2.957 2.957 0 0 1-.937 1.553c-.346.346-.8.565-1.286.62a2.178 2.178 0 0 1-1.327-.62 2.955 2.955 0 0 1-.925-1.553.244.244 0 0 1 .064-.198.234.234 0 0 1 .193-.069h3.965a.226.226 0 0 1 .19.07c.05.053.073.125.063.197Zm-5.458-2.176a1.862 1.862 0 0 1-2.384-.245 1.98 1.98 0 0 1-.233-2.447c.207-.319.503-.566.848-.713a1.84 1.84 0 0 1 1.092-.11c.366.075.703.261.967.531a1.98 1.98 0 0 1 .408 2.114 1.931 1.931 0 0 1-.698.869v.001Zm8.495.005a1.86 1.86 0 0 1-2.381-.253 1.964 1.964 0 0 1-.547-1.366c0-.384.11-.76.32-1.079.207-.319.503-.567.849-.713a1.844 1.844 0 0 1 1.093-.108c.367.076.704.262.968.534a1.98 1.98 0 0 1 .4 2.117 1.932 1.932 0 0 1-.702.868Z"/>
        </svg>
        Bun
      </button>
    </div>
    {nodeFile && (
      <span class="runtime-tab-filename" data-runtime-filename="node">{nodeFile}</span>
    )}
    {bunFile && (
      <span class="runtime-tab-filename" data-runtime-filename="bun" style="display:none">{bunFile}</span>
    )}
  </div>
  <div class="runtime-tabs-content">
    <div class="runtime-tab-panel active" data-runtime-panel="node" role="tabpanel">
      <pre><code set:html={node} /></pre>
    </div>
    <div class="runtime-tab-panel" data-runtime-panel="bun" role="tabpanel">
      <pre><code set:html={bun} /></pre>
    </div>
  </div>
</div>

<style>
  .runtime-code-tabs {
    margin: 1.5rem 0;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg-surface);
    overflow: hidden;
  }

  .runtime-tabs-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    overflow-x: auto;
  }

  .runtime-tabs-buttons {
    display: flex;
    gap: 0;
  }

  .runtime-tab-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.75rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 500;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .runtime-tab-icon {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
  }

  .runtime-tab-btn:hover {
    color: var(--color-text-secondary);
    background: rgba(255, 255, 255, 0.03);
  }

  /* Node.js active state — green */
  .runtime-tab-btn[data-runtime-tab="node"].active {
    color: #22c55e;
    border-bottom-color: #22c55e;
    background: rgba(34, 197, 94, 0.05);
  }

  /* Bun active state — amber */
  .runtime-tab-btn[data-runtime-tab="bun"].active {
    color: #f59e0b;
    border-bottom-color: #f59e0b;
    background: rgba(245, 158, 11, 0.05);
  }

  .runtime-tab-filename {
    padding: 0 1.25rem;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .runtime-tabs-content {
    position: relative;
  }

  .runtime-tab-panel {
    display: none;
    padding: 1rem 1.25rem;
  }

  .runtime-tab-panel.active {
    display: block;
  }

  .runtime-tab-panel pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
    overflow-x: auto;
  }

  .runtime-tab-panel code {
    background: none !important;
    border: none !important;
    padding: 0 !important;
  }

  /* Syntax highlighting */
  .runtime-tab-panel :global(.kw) { color: #c792ea; }
  .runtime-tab-panel :global(.str) { color: #a6e22e; }
  .runtime-tab-panel :global(.num) { color: #fd971f; }
  .runtime-tab-panel :global(.fn) { color: #66d9ef; }
  .runtime-tab-panel :global(.cm) { color: #71717a; }

  @media (prefers-reduced-motion: reduce) {
    .runtime-tab-btn {
      transition: none !important;
    }
  }
</style>

<script>
  function initRuntimeCodeTabs() {
    const stored = localStorage.getItem('hitlimit-runtime') || 'node';

    document.querySelectorAll('.runtime-code-tabs').forEach(container => {
      setActiveRuntime(container as HTMLElement, stored);
    });
  }

  function setActiveRuntime(container: HTMLElement, runtime: string) {
    const buttons = container.querySelectorAll<HTMLButtonElement>('.runtime-tab-btn');
    const panels = container.querySelectorAll<HTMLElement>('.runtime-tab-panel');
    const filenames = container.querySelectorAll<HTMLElement>('.runtime-tab-filename');

    // Update buttons
    buttons.forEach(btn => {
      const btnRuntime = btn.getAttribute('data-runtime-tab');
      const isActive = btnRuntime === runtime;
      btn.classList.toggle('active', isActive);
      btn.setAttribute('aria-selected', String(isActive));
      btn.setAttribute('tabindex', isActive ? '0' : '-1');
    });

    // Update panels
    panels.forEach(panel => {
      const panelRuntime = panel.getAttribute('data-runtime-panel');
      panel.classList.toggle('active', panelRuntime === runtime);
    });

    // Update filenames
    filenames.forEach(fn => {
      const fnRuntime = fn.getAttribute('data-runtime-filename');
      fn.style.display = fnRuntime === runtime ? '' : 'none';
    });
  }

  // Handle tab clicks — sync all instances and dispatch global event
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.runtime-tab-btn');
    if (!btn) return;

    const runtime = btn.getAttribute('data-runtime-tab');
    if (!runtime) return;

    // Persist selection
    localStorage.setItem('hitlimit-runtime', runtime);

    // Sync all RuntimeCodeTabs on the page
    document.querySelectorAll('.runtime-code-tabs').forEach(container => {
      setActiveRuntime(container as HTMLElement, runtime);
    });

    // Dispatch global event so other components (sidebar, etc.) can sync
    window.dispatchEvent(new CustomEvent('runtime-change', { detail: { runtime } }));
  });

  // Handle keyboard arrow navigation between tabs
  document.addEventListener('keydown', (e) => {
    const btn = e.target as HTMLElement;
    if (!btn.matches('.runtime-tab-btn')) return;
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;

    const tablist = btn.closest('.runtime-tabs-buttons');
    if (!tablist) return;

    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('.runtime-tab-btn'));
    const index = tabs.indexOf(btn as HTMLButtonElement);
    let nextIndex: number;

    if (e.key === 'ArrowRight') {
      nextIndex = (index + 1) % tabs.length;
    } else {
      nextIndex = (index - 1 + tabs.length) % tabs.length;
    }

    tabs[nextIndex].focus();
    tabs[nextIndex].click();
  });

  // Listen for global runtime changes from other components (e.g. sidebar switcher)
  window.addEventListener('runtime-change', ((e: CustomEvent<{ runtime: string }>) => {
    const runtime = e.detail?.runtime;
    if (!runtime) return;

    document.querySelectorAll('.runtime-code-tabs').forEach(container => {
      setActiveRuntime(container as HTMLElement, runtime);
    });
  }) as EventListener);

  initRuntimeCodeTabs();
  document.addEventListener('astro:after-swap', initRuntimeCodeTabs);
</script>
