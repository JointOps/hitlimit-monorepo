---
import { bench, formatOps } from '../data/benchmarks';

interface SearchItem {
  title: string;
  section: string;
  href: string;
  content: string;
  headings: string[];
  runtime: 'node' | 'bun' | 'both';
}

// Comprehensive search data for all docs
