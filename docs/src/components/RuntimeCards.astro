---
import { bench, formatOpsPlus } from '../data/benchmarks';

const nodeOpsPlus = formatOpsPlus(bench.node.memory.singleIp.opsPerSec);
const bunOpsPlus = formatOpsPlus(bench.bun.memory.singleIp.opsPerSec);
const nodeBundleSize = bench.bundleSize.node.core;
const bunBundleSize = bench.bundleSize.bun.core;
---

<section class="py-24 px-4 section-divider">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 reveal">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
        One library, <span class="gradient-text">every runtime</span>
      </h2>
      <p class="text-lg text-[var(--color-text-secondary)] max-w-2xl mx-auto">
        Works out of the box with Node.js and Bun. Same API, same performance, same simplicity.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 reveal-stagger">
      <!-- Node.js Card -->
      <a href="/docs/quick-start" class="reveal-child group runtime-card runtime-card-node block relative p-8 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-surface)] transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl no-underline">
        <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-[var(--color-runtime-node-bg)] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative">
          <!-- Logo + Name -->
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-xl bg-[var(--color-runtime-node-bg)] border border-[var(--color-runtime-node-border)] flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:shadow-[0_0_20px_var(--color-runtime-node-glow)]">
              <svg class="w-7 h-7 text-[var(--color-runtime-node)]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.998 24c-.321 0-.641-.084-.922-.247l-2.936-1.737c-.438-.245-.224-.332-.08-.383.585-.203.703-.25 1.328-.604.065-.037.151-.023.218.017l2.256 1.339c.082.045.197.045.272 0l8.795-5.076c.082-.047.134-.141.134-.238V6.921c0-.099-.053-.192-.137-.242l-8.791-5.072c-.081-.047-.189-.047-.271 0L3.075 6.68c-.084.049-.137.142-.137.24v10.15c0 .097.054.189.139.235l2.409 1.392c1.307.654 2.108-.116 2.108-.89V7.787c0-.142.114-.253.256-.253h1.115c.139 0 .255.112.255.253v10.021c0 1.745-.95 2.745-2.604 2.745-.508 0-.909 0-2.026-.551L2.28 18.675c-.57-.329-.922-.945-.922-1.604V6.921c0-.659.353-1.275.922-1.603l8.795-5.082c.557-.315 1.296-.315 1.848 0l8.794 5.082c.57.329.924.944.924 1.603v10.15c0 .659-.354 1.273-.924 1.604l-8.794 5.078C12.643 23.916 12.324 24 11.998 24zM19.099 13.993c0-1.9-1.284-2.406-3.987-2.763-2.731-.361-3.009-.548-3.009-1.187 0-.528.235-1.233 2.258-1.233 1.807 0 2.473.389 2.747 1.607.024.115.129.199.247.199h1.141c.071 0 .138-.031.186-.081.048-.054.074-.123.067-.196-.177-2.098-1.571-3.076-4.388-3.076-2.508 0-4.004 1.058-4.004 2.833 0 1.925 1.488 2.457 3.895 2.695 2.88.282 3.103.703 3.103 1.269 0 .983-.789 1.402-2.642 1.402-2.327 0-2.839-.584-3.011-1.742-.02-.124-.126-.215-.253-.215h-1.137c-.141 0-.254.112-.254.253 0 1.482.806 3.248 4.655 3.248 2.855 0 4.453-1.097 4.453-2.98z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white">Node.js</h3>
              <p class="text-sm text-[var(--color-text-muted)]">@joint-ops/hitlimit</p>
            </div>
          </div>

          <!-- Frameworks -->
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white/5 border border-[var(--color-border)] text-xs font-medium text-[var(--color-text-secondary)]"><span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>Express</span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white/5 border border-[var(--color-border)] text-xs font-medium text-[var(--color-text-secondary)]"><span class="w-1.5 h-1.5 rounded-full bg-white"></span>Fastify</span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white/5 border border-[var(--color-border)] text-xs font-medium text-[var(--color-text-secondary)]"><span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>Hono</span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white/5 border border-[var(--color-border)] text-xs font-medium text-[var(--color-text-secondary)]"><span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>NestJS</span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white/5 border border-[var(--color-border)] text-xs font-medium text-[var(--color-text-secondary)]"><span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Node.js HTTP</span>
          </div>

          <!-- Stats -->
          <div class="grid grid-cols-3 gap-4 mb-6">
            <div>
              <div class="text-2xl font-black text-[var(--color-runtime-node)]">{nodeOpsPlus}</div>
              <div class="text-xs text-[var(--color-text-muted)]">ops/sec</div>
            </div>
            <div>
              <div class="text-2xl font-black text-white">5</div>
              <div class="text-xs text-[var(--color-text-muted)]">adapters</div>
            </div>
            <div>
              <div class="text-2xl font-black text-white">{nodeBundleSize}</div>
              <div class="text-xs text-[var(--color-text-muted)]">core bundle</div>
            </div>
          </div>

          <!-- Install command -->
          <div class="flex items-center gap-2 px-4 py-3 rounded-xl bg-[var(--color-bg-elevated)] border border-[var(--color-border)] font-mono text-sm">
            <span class="text-[var(--color-text-muted)]">$</span>
            <span class="text-[var(--color-text-secondary)]">npm i @joint-ops/hitlimit</span>
          </div>

          <!-- CTA -->
          <div class="mt-6 flex items-center gap-2 text-[var(--color-runtime-node)] font-semibold text-sm group-hover:gap-3 transition-all duration-300">
            Node.js Docs
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      </a>

      <!-- Bun Card -->
      <a href="/docs/bun/quick-start" class="reveal-child group runtime-card runtime-card-bun block relative p-8 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-surface)] transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl no-underline">
        <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-[var(--color-runtime-bun-bg)] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative">
          <!-- Logo + Name -->
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-xl bg-[var(--color-runtime-bun-bg)] border border-[var(--color-runtime-bun-border)] flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:shadow-[0_0_20px_var(--color-runtime-bun-glow)]">
              <svg class="w-7 h-7 text-[var(--color-runtime-bun)]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 22.596c6.628 0 12-4.338 12-9.688 0-3.318-2.057-6.248-5.219-7.986-1.286-.715-2.297-1.357-3.139-1.89C14.058 2.025 13.08 1.404 12 1.404c-1.097 0-2.334.785-3.966 1.821a49.92 49.92 0 0 1-2.816 1.697C2.057 6.66 0 9.59 0 12.908c0 5.35 5.372 9.687 12 9.687v.001ZM10.599 4.715c.334-.759.503-1.58.498-2.409 0-.145.202-.187.23-.029.658 2.783-.902 4.162-2.057 4.624-.124.048-.199-.121-.103-.209a5.763 5.763 0 0 0 1.432-1.977Zm2.058-.102a5.82 5.82 0 0 0-.782-2.306v-.016c-.069-.123.086-.263.185-.172 1.962 2.111 1.307 4.067.556 5.051-.082.103-.23-.003-.189-.126a5.85 5.85 0 0 0 .23-2.431Zm1.776-.561a5.727 5.727 0 0 0-1.612-1.806v-.014c-.112-.085-.024-.274.114-.218 2.595 1.087 2.774 3.18 2.459 4.407a.116.116 0 0 1-.049.071.11.11 0 0 1-.153-.026.122.122 0 0 1-.022-.083 5.891 5.891 0 0 0-.737-2.331Zm-5.087.561c-.617.546-1.282.76-2.063 1-.117 0-.195-.078-.156-.181 1.752-.909 2.376-1.649 2.999-2.778 0 0 .155-.118.188.085 0 .304-.349 1.329-.968 1.874Zm4.945 11.237a2.957 2.957 0 0 1-.937 1.553c-.346.346-.8.565-1.286.62a2.178 2.178 0 0 1-1.327-.62 2.955 2.955 0 0 1-.925-1.553.244.244 0 0 1 .064-.198.234.234 0 0 1 .193-.069h3.965a.226.226 0 0 1 .19.07c.05.053.073.125.063.197Zm-5.458-2.176a1.862 1.862 0 0 1-2.384-.245 1.98 1.98 0 0 1-.233-2.447c.207-.319.503-.566.848-.713a1.84 1.84 0 0 1 1.092-.11c.366.075.703.261.967.531a1.98 1.98 0 0 1 .408 2.114 1.931 1.931 0 0 1-.698.869v.001Zm8.495.005a1.86 1.86 0 0 1-2.381-.253 1.964 1.964 0 0 1-.547-1.366c0-.384.11-.76.32-1.079.207-.319.503-.567.849-.713a1.844 1.844 0 0 1 1.093-.108c.367.076.704.262.968.534a1.98 1.98 0 0 1 .4 2.117 1.932 1.932 0 0 1-.702.868Z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white">Bun</h3>
              <p class="text-sm text-[var(--color-text-muted)]">@joint-ops/hitlimit-bun</p>
            </div>
          </div>

          <!-- Frameworks -->
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white/5 border border-[var(--color-border)] text-xs font-medium text-[var(--color-text-secondary)]"><span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>Bun.serve</span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white/5 border border-[var(--color-border)] text-xs font-medium text-[var(--color-text-secondary)]"><span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>Elysia</span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white/5 border border-[var(--color-border)] text-xs font-medium text-[var(--color-text-secondary)]"><span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>Hono</span>
          </div>

          <!-- Stats -->
          <div class="grid grid-cols-3 gap-4 mb-6">
            <div>
              <div class="text-2xl font-black text-[var(--color-runtime-bun)]">{bunOpsPlus}</div>
              <div class="text-xs text-[var(--color-text-muted)]">ops/sec</div>
            </div>
            <div>
              <div class="text-2xl font-black text-white">3</div>
              <div class="text-xs text-[var(--color-text-muted)]">adapters</div>
            </div>
            <div>
              <div class="text-2xl font-black text-white">{bunBundleSize}</div>
              <div class="text-xs text-[var(--color-text-muted)]">core bundle</div>
            </div>
          </div>

          <!-- Install command -->
          <div class="flex items-center gap-2 px-4 py-3 rounded-xl bg-[var(--color-bg-elevated)] border border-[var(--color-border)] font-mono text-sm">
            <span class="text-[var(--color-text-muted)]">$</span>
            <span class="text-[var(--color-text-secondary)]">bun add @joint-ops/hitlimit-bun</span>
          </div>

          <!-- CTA -->
          <div class="mt-6 flex items-center gap-2 text-[var(--color-runtime-bun)] font-semibold text-sm group-hover:gap-3 transition-all duration-300">
            Bun Docs
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      </a>
    </div>

    <p class="text-center text-sm text-[var(--color-text-muted)] mt-8">
      Not sure which to use? Both share the same API. Start with your runtime and switch anytime.
    </p>
  </div>
</section>

<style>
  .runtime-card-node:hover {
    border-color: var(--color-runtime-node-border);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5), 0 0 40px rgba(34, 197, 94, 0.1);
  }
  .runtime-card-bun:hover {
    border-color: var(--color-runtime-bun-border);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5), 0 0 40px rgba(245, 158, 11, 0.1);
  }
</style>
