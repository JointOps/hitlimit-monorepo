---
interface Props {
  currentRuntime: 'node' | 'bun';
  counterpartHref: string;
  counterpartLabel: string;
}

const { currentRuntime, counterpartHref, counterpartLabel } = Astro.props;

const isNode = currentRuntime === 'node';
const otherRuntime = isNode ? 'Bun' : 'Node.js';
const packageName = isNode ? '@joint-ops/hitlimit-bun' : '@joint-ops/hitlimit';
const bannerClass = isNode ? 'runtime-banner-bun' : 'runtime-banner-node';
---

<div class={`runtime-banner ${bannerClass}`} role="note">
  <svg class="runtime-banner-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M5 12h14M12 5l7 7-7 7"/>
  </svg>
  <p class="runtime-banner-text">
    <strong>Using {otherRuntime}?</strong>
    {' '}See the <a href={counterpartHref} class="runtime-banner-link">{counterpartLabel}</a> for <code>{packageName}</code>.
  </p>
</div>

<style>
  .runtime-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    margin: 0 0 2rem 0;
    border-radius: 0 8px 8px 0;
    border-left: 3px solid;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Bun accent (shown on Node.js pages, linking to Bun) */
  .runtime-banner-bun {
    background: rgba(245, 158, 11, 0.05);
    border-left-color: var(--color-runtime-bun);
  }

  .runtime-banner-bun .runtime-banner-link {
    color: var(--color-runtime-bun);
  }

  .runtime-banner-bun .runtime-banner-icon {
    color: var(--color-runtime-bun);
  }

  /* Node.js accent (shown on Bun pages, linking to Node.js) */
  .runtime-banner-node {
    background: rgba(34, 197, 94, 0.05);
    border-left-color: var(--color-runtime-node);
  }

  .runtime-banner-node .runtime-banner-link {
    color: var(--color-runtime-node);
  }

  .runtime-banner-node .runtime-banner-icon {
    color: var(--color-runtime-node);
  }

  .runtime-banner-icon {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
  }

  .runtime-banner-text {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .runtime-banner-text strong {
    color: #e4e4e7;
    font-weight: 600;
  }

  .runtime-banner-text code {
    font-size: 0.8125rem;
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-secondary);
  }

  .runtime-banner-link {
    text-decoration: none;
    font-weight: 500;
    transition: text-decoration 0.15s ease;
  }

  .runtime-banner-link:hover {
    text-decoration: underline;
  }
</style>
