---
const features = [
  { name: 'Framework adapters', hitlimit: '8 built-in', expressRL: '1', rateFlexible: 'DIY', nestThrottler: '1', highlight: true },
  { name: 'Human time windows', hitlimit: "'15m'", expressRL: '900000', rateFlexible: '900', nestThrottler: '60000', highlight: true },
  { name: 'Tiered limits (SaaS)', hitlimit: 'Built-in', expressRL: 'Manual', rateFlexible: 'Manual', nestThrottler: 'Per-route', highlight: true },
  { name: 'Bun native support', hitlimit: 'bun:sqlite', expressRL: false, rateFlexible: false, nestThrottler: false, highlight: true },
  { name: 'Auto-ban on abuse', hitlimit: true, expressRL: false, rateFlexible: true, nestThrottler: true },
  { name: 'Storage backends', hitlimit: '8', expressRL: '5', rateFlexible: '14', nestThrottler: '2' },
  { name: 'Standard headers', hitlimit: 'Both', expressRL: 'Both', rateFlexible: 'Manual', nestThrottler: 'Legacy' },
  { name: 'MongoDB / MySQL / Postgres', hitlimit: true, expressRL: 'External', rateFlexible: true, nestThrottler: false },
  { name: 'Weighted requests', hitlimit: false, expressRL: false, rateFlexible: true, nestThrottler: false, gap: true },
] as const;

type Feature = (typeof features)[number];

function renderValue(val: boolean | string) {
  if (val === true) return { icon: 'check', color: 'green' } as const;
  if (val === false) return { icon: 'x', color: 'red' } as const;
  if (val === 'Manual' || val === 'DIY' || val === 'External' || val === 'Per-route' || val === 'Legacy') return { text: val, color: 'yellow' } as const;
  return { text: val, color: 'green' } as const;
}

function renderCell(val: ReturnType<typeof renderValue>) {
  return val;
}
---

<section class="py-24 px-4 section-divider">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-12 reveal">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
        Honest <span class="gradient-text">side-by-side</span>
      </h2>
      <p class="text-lg text-[var(--color-text-secondary)] max-w-2xl mx-auto">
        We show what we don't support yet, too. No hidden footnotes.
      </p>
    </div>

    <!-- Comparison table -->
    <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-surface)] overflow-hidden reveal">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[640px]">
          <thead>
            <tr class="bg-[var(--color-bg-elevated)] border-b border-[var(--color-border)]">
              <th class="text-left p-4 text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wider">Feature</th>
              <th class="text-center p-4 text-xs font-semibold uppercase tracking-wider">
                <span class="gradient-text">hitlimit</span>
              </th>
              <th class="text-center p-4 text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wider whitespace-nowrap">express-rate-limit</th>
              <th class="text-center p-4 text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wider whitespace-nowrap">rate-limiter-flexible</th>
              <th class="text-center p-4 text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wider">@nestjs/throttler</th>
            </tr>
          </thead>
          <tbody>
            {features.map((feature) => {
              const isGap = 'gap' in feature && feature.gap;
              const isHighlight = 'highlight' in feature && feature.highlight;
              const hitlimitVal = renderValue(feature.hitlimit);
              const expressVal = renderValue(feature.expressRL);
              const flexVal = renderValue(feature.rateFlexible);
              const nestVal = renderValue(feature.nestThrottler);

              return (
                <tr class={`border-b border-[var(--color-border)] last:border-0 ${isHighlight ? 'bg-[var(--color-accent)]/5' : ''} ${isGap ? 'bg-yellow-500/[0.03]' : ''} hover:bg-[var(--color-bg-elevated)] transition-colors`}>
                  <td class="p-4 text-sm font-medium text-white">
                    {feature.name}
                    {isGap && (
                      <span class="ml-2 px-1.5 py-0.5 rounded text-[10px] font-semibold bg-yellow-500/15 text-yellow-400 uppercase">Planned</span>
                    )}
                  </td>
                  {[hitlimitVal, expressVal, flexVal, nestVal].map((val) => (
                    <td class="p-4 text-center">
                      {val.icon === 'check' ? (
                        <svg class="w-5 h-5 mx-auto text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                          <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      ) : val.icon === 'x' ? (
                        <svg class="w-5 h-5 mx-auto text-red-400/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      ) : (
                        <span class={`text-sm font-mono font-medium ${'color' in val && val.color === 'yellow' ? 'text-yellow-400' : 'text-green-400'}`}>{val.text}</span>
                      )}
                    </td>
                  ))}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Legend -->
    <div class="mt-4 flex flex-wrap justify-center gap-6 text-xs text-[var(--color-text-muted)]">
      <div class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Built-in
      </div>
      <div class="flex items-center gap-1.5">
        <span class="text-yellow-400 font-mono text-[10px]">Manual</span>
        External / DIY
      </div>
      <div class="flex items-center gap-1.5">
        <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-yellow-500/15 text-yellow-400 uppercase">Planned</span>
        On roadmap
      </div>
    </div>
  </div>
</section>
